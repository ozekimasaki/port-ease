<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PortBan.Views.MainWindow"
        Title="ポート番"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="460"
        Icon="avares://PortBan/Assets/portban.ico"
        Background="#101820"
        Foreground="#E6EDF3"
        FontSize="13"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button.kill">
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
                <TextBlock Text="ポート番" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="待ち受けポートと、その用途・プロセスを表示します" FontSize="12" Opacity="0.7"/>
            </StackPanel>
            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Text="0 件"
                       FontSize="16"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="FilterBox"
                     Watermark="ポート・プロセス・用途で絞り込み"
                     TextChanged="OnFilterChanged"/>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Content="更新"
                    MinWidth="84"
                    Click="OnRefreshClick"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <DataGrid x:Name="PortGrid"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="1"
                      BorderBrush="#243140"
                      RowHeight="36"
                      SelectionMode="Single"
                      IsVisible="False"
                      SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ポート" Binding="{Binding Port}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="プロトコル" Binding="{Binding Protocol}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="アドレス" Binding="{Binding Address}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="プロセス" Binding="{Binding ProcessName}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="用途" Binding="{Binding Purpose}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="" Width="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Classes="kill"
                                        Content="終了"
                                        IsEnabled="{Binding CanKill}"
                                        Click="OnKillClick"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText"
                       Text="読み込み中…"
                       FontSize="16"
                       Opacity="0.85"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="#172330"
                CornerRadius="6">
            <StackPanel Spacing="4">
                <TextBlock Text="コマンドライン" FontSize="11" Opacity="0.65"/>
                <TextBox x:Name="CommandText"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         MaxHeight="64"
                         Watermark="行を選ぶとコマンドラインを表示します"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ErrorText"
                       Foreground="#F0A8A8"
                       TextWrapping="Wrap"
                       IsVisible="False"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       Opacity="0.6"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Text="閉じる・最小化でトレイに残ります"/>
        </Grid>
    </Grid>
</Window>
